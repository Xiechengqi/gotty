{
  "compilerOptions": {
    "outDir": "./dist/",
    "rootDir": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "declaration": true,
    "sourceMap": true,
    "target": "esnext",
    "module": "ESNext",
    "ignoreDeprecations": "6.0",
    "types": [
      "preact",
      "node"
    ],
    "paths": {
      "*": [
        "./typings/*"
      ]
    },
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "e2e",
    "vitest.config.mts",
    "playwright.config.ts"
  ]
}
